<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ClassCard AI Helper" android:textColor="@color/text" android:textSize="26sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="영어 연습 화면을 읽고 정답 후보를 표시합니다. 정답 선택은 직접 눌러주세요." android:textColor="#5B6573" android:textSize="14sp"/><EditText android:id="@+id/apiKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:hint="OpenAI API key" android:inputType="textPassword" android:singleLine="true"/><EditText android:id="@+id/modelName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="모델" android:singleLine="true" android:text="gpt-5.6"/><Button android:id="@+id/saveApi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="API 설정 저장"/><TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="상태: 정지" android:textSize="17sp" android:textStyle="bold"/><TextView android:id="@+id/lastQuestion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="마지막 인식: -" android:textColor="#5B6573"/><TextView android:id="@+id/lastAnswer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="AI 추천: -" android:textColor="@color/green" android:textSize="18sp" android:textStyle="bold"/><Button android:id="@+id/startBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="실시간 분석 시작"/><Button android:id="@+id/stopBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="중지"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="연습/학습 보조용입니다. 자동 터치·자동 제출 기능은 포함하지 않습니다." android:textColor="#7A3E00" android:textSize="12sp"/></LinearLayout></ScrollView>
